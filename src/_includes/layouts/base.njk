<!doctype html>
<html lang="{{ locale.htmlLang }}" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="{{ viewport or 'width=device-width, initial-scale=1' }}" />
  <title>{{ p.meta.title }}</title>
  <meta name="description" content="{{ p.meta.description }}" />
  {% if canonical %}<link rel="canonical" href="{{ canonical }}" />{% endif %}
  {% if p.meta.robots or (pageKey == "articles" and locale.code != "fr") %}<meta name="robots" content="{{ p.meta.robots or 'noindex, follow' }}" />{% endif %}
  <meta property="og:type" content="{{ 'article' if pageKey == 'article' else 'website' }}" />
  <meta property="og:locale" content="{{ locale.ogLocale }}" />
  {% for alt in alternates %}{% if alt.code != locale.code %}<meta property="og:locale:alternate" content="{{ alt.ogLocale }}" />{% endif %}{% endfor %}
  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:title" content="{{ p.meta.ogTitle or p.meta.title }}" />
  <meta property="og:description" content="{{ p.meta.ogDescription or p.meta.description }}" />
  {% if canonical %}<meta property="og:url" content="{{ canonical }}" />{% endif %}
  {% set socialImage = p.meta.ogImage or site.ogImage or site.logoLight %}
  <meta property="og:image" content="{{ socialImage | absoluteUrl(site.baseUrl) }}" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="{{ site.ogImageAlt }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="{{ socialImage | absoluteUrl(site.baseUrl) }}" />
  <meta name="theme-color" content="#f4f1e5" />
  {% for alt in alternates %}<link rel="alternate" hreflang="{{ alt.hreflang }}" href="{{ alt.href }}" />{% endfor %}
  {% if (pageKey == "theme" or pageKey == "useCase") and alternates.length %}<link rel="alternate" hreflang="x-default" href="{{ alternates[0].href }}" />{% elif pageKey != "notFound" and pageKey != "article" and pageKey != "articles" and pageKey != "seoPage" %}<link rel="alternate" hreflang="x-default" href="{{ site.baseUrl }}{{ allLocales[0].routes[pageKey] }}" />{% endif %}
  {% for href in css %}<link rel="stylesheet" href="{{ href }}" />{% endfor %}
  {% for href in deferCss %}<link rel="stylesheet" href="{{ href }}" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="{{ href }}" /></noscript>{% endfor %}
  <link rel="stylesheet" href="/assets/css/i18n.css?v=2" />
  <link rel="icon" href="{{ site.logoLight }}" type="image/webp" />
  {% if headExtra %}{{ headExtra | safe }}{% endif %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "{{ site.baseUrl }}/#organization",
        "name": "ONIR CMS",
        "url": "{{ site.baseUrl }}/",
        "logo": "{{ site.baseUrl }}{{ site.logoLight }}",
        "sameAs": [{{ site.github | dump | safe }}, {{ site.linkedin | dump | safe }}, {{ site.facebook | dump | safe }}]
      },
      {
        "@type": "WebSite",
        "@id": "{{ site.baseUrl }}/#website",
        "url": "{{ site.baseUrl }}/",
        "name": "ONIR CMS",
        "publisher": { "@id": "{{ site.baseUrl }}/#organization" },
        "inLanguage": ["fr", "en", "mg"]
      }
      {% if pageKey == "home" %},
      {
        "@type": "SoftwareApplication",
        "@id": "{{ site.baseUrl }}/#software-open-source",
        "name": "ONIR CMS (open source)",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web",
        "url": "{{ site.baseUrl }}/",
        "description": "CMS open source sous licence MIT pour créer des chatbots et des assistants IA auto-hébergés.",
        "isAccessibleForFree": true,
        "license": "https://opensource.org/license/mit/",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" },
        "sameAs": "{{ site.github }}",
        "publisher": { "@id": "{{ site.baseUrl }}/#organization" }
      },
      {
        "@type": "Service",
        "@id": "{{ site.baseUrl }}/#cloud",
        "name": "ONIR CMS Cloud",
        "serviceType": "SaaS de chatbot et d’assistant IA",
        "provider": { "@id": "{{ site.baseUrl }}/#organization" },
        "areaServed": { "@type": "Country", "name": "Madagascar" },
        "url": "{{ site.baseUrl }}/tarifs/",
        "description": "Service Cloud hébergé par ONIR CMS, disponible à Madagascar, avec des offres et des tarifs consultables sur la page Tarifs."
      }
      {% endif %}
      {% if pageKey == "article" %},
      {
        "@type": "Article",
        "headline": {{ title | dump | safe }},
        "description": {{ excerpt | dump | safe }},
        "datePublished": "{{ publishedAt }}",
        "author": { "@type": "Person", "name": {{ author | dump | safe }} },
        "image": "{{ (cover or site.ogImage) | absoluteUrl(site.baseUrl) }}",
        "mainEntityOfPage": "{{ canonical }}",
        "publisher": { "@id": "{{ site.baseUrl }}/#organization" }
      }
      {% endif %}
      {% if pageKey == "features" %},
      {
        "@type": "FAQPage",
        "mainEntity": [
          {% for item in p.faq.items %}
          {
            "@type": "Question",
            "name": {{ item.q | dump | safe }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} }
          }{% if not loop.last %},{% endif %}
          {% endfor %}
        ]
      }
      {% endif %}
      {% if pageKey == "theme" and themePage %},
      {
        "@type": "SoftwareApplication",
        "name": {{ themePage.theme.name | dump | safe }},
        "softwareVersion": "{{ themePage.theme.version }}",
        "applicationCategory": "DesignApplication",
        "operatingSystem": "Web",
        "description": {{ themePage.theme.description | dump | safe }},
        "image": "{{ site.baseUrl }}/assets/themes/{{ themePage.theme.id }}.png",
        "downloadUrl": "{{ themePage.download.download | absoluteUrl(site.baseUrl) }}",
        "author": { "@type": "Person", "name": {{ themePage.theme.author | dump | safe }} },
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" }
      }
      {% endif %}
      {% if pageKey == "seoPage" and seoPage %},
      {
        "@type": "WebPage",
        "@id": "{{ canonical }}",
        "url": "{{ canonical }}",
        "name": {{ seoPage.data.meta.title | dump | safe }},
        "description": {{ seoPage.data.meta.description | dump | safe }},
        "inLanguage": "fr",
        "isPartOf": { "@id": "{{ site.baseUrl }}/#website" }
      }{% if seoPage.kind == "openSource" %},
      {
        "@type": "SoftwareSourceCode",
        "name": "ONIR CMS",
        "codeRepository": "{{ site.github }}",
        "license": "https://opensource.org/license/mit/",
        "isAccessibleForFree": true,
        "author": { "@id": "{{ site.baseUrl }}/#organization" },
        "url": "{{ canonical }}"
      }{% elif seoPage.kind == "expertise" %},
      {
        "@type": "Service",
        "name": "Expertise IA ONIRTECH",
        "serviceType": "Conception et déploiement d’assistants IA",
        "provider": { "@id": "{{ site.baseUrl }}/#organization" },
        "areaServed": { "@type": "Country", "name": "Madagascar" },
        "url": "{{ canonical }}",
        "description": {{ seoPage.data.meta.description | dump | safe }}
      }{% endif %}{% if seoPage.data.faq and seoPage.data.faq.items %},
      {
        "@type": "FAQPage",
        "mainEntity": [
          {% for item in seoPage.data.faq.items %}
          {
            "@type": "Question",
            "name": {{ item.q | dump | safe }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} }
          }{% if not loop.last %},{% endif %}
          {% endfor %}
        ]
      }{% endif %}
      {% endif %}
    ]
  }
  </script>
  <script>
    (function () {
      try {
        var t = localStorage.getItem("onir-theme");
        if (t !== "light" && t !== "dark") t = localStorage.getItem("proto-theme");
        if (t !== "light" && t !== "dark") t = localStorage.getItem("theme");
        if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = t;
      } catch (e) {}
    })();
  </script>
</head>
<body>
  {% if wrapper %}<div class="{{ wrapper }}">{% endif %}
  {% if headerVariant == "legacy" %}{% set skipClass = "site-skip" %}{% else %}{% set skipClass = "skip" %}{% endif %}
  <a class="{{ skipClass }}" href="#contenu">{{ t.common.skip }}</a>

  {% include "partials/header.njk" %}

  <main id="contenu"{% if mainClass %} class="{{ mainClass }}"{% endif %}{% if mainAttrs %} {{ mainAttrs | safe }}{% endif %}>
    {{ content | safe }}
  </main>

  {% include "partials/contact.njk" %}
  {% include "partials/footer.njk" %}
  {% if wrapper %}</div>{% endif %}

  <script src="/assets/js/main.js?v=20261112" defer></script>
  {% for script in bodyScripts %}<script src="{{ script }}" defer></script>
  {% endfor %}  {% if showWidget != false %}
  <script
    async
    src="{{ site.widget.src }}"
    data-onir-token="{{ site.widget.token }}"
    data-onir-position="{{ site.widget.position }}"
  ></script>
  {% endif %}
</body>
</html>
