{% if headerVariant == "legacy" %}
<header class="site-head">
  <div class="site-wrap site-head-inner">
    <a href="{{ locale.routes.home }}" class="brand brand-logo site-brand" aria-label="{{ t.common.brandHome }}">
      <img class="logo-light" src="{{ site.logoLight }}" alt="{{ site.name }}" width="600" height="177" />
      <img class="logo-dark" src="{{ site.logoDark }}" alt="" aria-hidden="true" width="600" height="177" />
    </a>

    {% set navClass = "site-nav" %}
    {% set navAria = t.common.nav.aria %}
    {% include "partials/nav.njk" %}

    <div class="site-actions">
      {% include "partials/lang-switcher.njk" %}
      <button type="button" class="site-theme-toggle" data-theme-toggle
        data-theme-label-light="{{ t.common.theme.light }}"
        data-theme-label-dark="{{ t.common.theme.dark }}"
        aria-label="{{ t.common.theme.toggle }}">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41" />
        </svg>
      </button>
      <a href="{{ site.login }}" class="site-button site-button-sm">{{ t.common.nav.login }}</a>
    </div>
  </div>
</header>
{% else %}
<header class="site-head">
  <div class="wrap head-inner">
    <a class="brand" href="{{ locale.routes.home }}" aria-label="{{ t.common.brandHome }}">
      <img class="light" src="{{ site.logoLight }}" alt="{{ site.name }}" width="600" height="177" />
      <img class="dark" src="{{ site.logoDark }}" alt="" width="600" height="177" />
    </a>

    {% set navClass = "nav" %}
    {% set navAria = t.common.nav.aria %}
    {% include "partials/nav.njk" %}

    <div class="head-actions">
      <button class="icon-btn menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="primary-nav" aria-label="Menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
      {% include "partials/lang-switcher.njk" %}
      <button class="icon-btn" type="button" data-theme-toggle
        data-theme-label-light="{{ t.common.theme.light }}"
        data-theme-label-dark="{{ t.common.theme.dark }}"
        aria-label="{{ t.common.theme.toggle }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" />
        </svg>
      </button>
      <a class="btn btn-sm" href="{{ site.login }}">{{ t.common.nav.login }}</a>
    </div>
  </div>
</header>
{% endif %}
