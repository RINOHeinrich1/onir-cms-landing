<section class="section wrap" id="pricing">
  {% if pageKey != "pricing" %}
  <div class="section-head">
    <p class="kicker">{{ t.pricing.kicker }}</p>
    <h2>{{ t.pricing.title }}</h2>
    <p>{{ t.pricing.lead }}</p>
  </div>
  {% endif %}
  <div class="pricing-grid">
    {% if pageKey == "pricing" %}
    <article class="price-card">
      <span class="price-tag">{{ t.pricing.selfHosted.badge }}</span>
      <h3>{{ t.pricing.selfHosted.title }}</h3>
      <p class="price">{{ t.pricing.selfHosted.price }}</p>
      <p>{{ t.pricing.selfHosted.lead }}</p>
      <ul class="price-list">
        {% for item in t.pricing.selfHosted.items %}<li>{{ item }}</li>{% endfor %}
      </ul>
      <a class="btn btn-ghost" href="{{ site.github }}" target="_blank" rel="noreferrer">{{ t.pricing.selfHosted.cta }}</a>
    </article>
    {% endif %}

    <article class="price-card price-card-featured">
      <span class="price-tag">{{ t.pricing.cloud.badge }}</span>
      <h3>{{ t.pricing.cloud.title }}</h3>
      <p>{{ t.pricing.cloud.lead }}</p>
      <p class="price-empty">{{ t.pricing.cloud.detail }}</p>
      <a class="btn btn-accent" href="{{ locale.routes.pricing }}#offres-cloud">{{ t.pricing.cloud.cta }}</a>
    </article>

    <article class="price-card">
      <span class="price-tag">{{ t.pricing.enterprise.badge }}</span>
      <h3>{{ t.pricing.enterprise.title }}</h3>
      <p>{{ t.pricing.enterprise.lead }}</p>
      <ul class="price-list">
        {% for item in t.pricing.enterprise.items %}<li>{{ item }}</li>{% endfor %}
      </ul>
      <button class="btn btn-accent" type="button" data-rdv-open>{{ t.pricing.enterprise.cta }}</button>
    </article>

    {% if pageKey != "pricing" %}
    <article class="price-card">
      <span class="price-tag">{{ t.pricing.partner.badge }}</span>
      <h3>{{ t.pricing.partner.title }}</h3>
      <p>{{ t.pricing.partner.lead }}</p>
      <a class="btn btn-ghost" href="{{ locale.routes.participate }}">{{ t.pricing.partner.cta }}</a>
    </article>
    {% endif %}
  </div>
</section>

{% if pageKey == "pricing" %}
<section class="section wrap cloud-offers-section" id="offres-cloud">
  <div class="section-head">
    <p class="kicker">{{ t.pricing.cloud.badge }}</p>
    <h2>{{ t.pricing.cloud.offersTitle }}</h2>
    <p>{{ t.pricing.cloud.offersLead }}</p>
  </div>
  {% if pricing.offers.length %}
  <div class="duration-switch" data-duration-switch aria-label="{{ t.pricing.durationLabels["1"] }}">
    <button class="duration-tab is-active" data-months="1" type="button">{{ t.pricing.durationLabels["1"] }}</button>
    <button class="duration-tab" data-months="3" type="button">{{ t.pricing.durationLabels["3"] }}</button>
    <button class="duration-tab" data-months="6" type="button">{{ t.pricing.durationLabels["6"] }}</button>
    <button class="duration-tab" data-months="12" type="button">{{ t.pricing.durationLabels["12"] }}</button>
  </div>
  <div class="cloud-detail-grid">
    {% for offer in pricing.offers %}
    <article class="cloud-detail-card" data-cloud-card>
      <div class="cloud-offer-head">
        <strong>{{ offer.name }}</strong>
        {% set offerDescription = t.pricing.offerDescriptions[offer.code] or offer.description %}
        {% if offerDescription %}<span>{{ offerDescription }}</span>{% endif %}
      </div>
      <div class="cloud-includes">
        {% if offer.maxChatbots != null %}<span>{{ offer.maxChatbots }} {{ t.pricing.includedChatbots }}</span>{% endif %}
        {% if offer.tokensLabel %}<span>{{ offer.tokensLabel }}</span>{% endif %}
        {% if offer.maxMessages != null %}<span>{{ offer.maxMessagesFormatted }} {{ t.pricing.includedMessages }}</span>{% endif %}
        {% if offer.maxStorageMb != null %}
        <span>{% if offer.maxStorageMb >= 1024 %}{{ offer.maxStorageMb / 1024 }} {{ t.pricing.storageGb }}{% else %}{{ offer.maxStorageMb }} {{ t.pricing.storageMb }}{% endif %}</span>
        {% endif %}
      </div>
      <select class="cloud-duration" hidden aria-label="{{ t.pricing.subscription.duration }}">
        {% for duration in offer.durations %}
        <option value="{{ duration.months }}" data-price="{{ duration.priceLabel }}" data-period="{{ t.pricing.pricePeriod[duration.months] }}"{% if loop.first %} selected{% endif %}>{{ duration.months }} {{ t.pricing.months }} — {{ duration.priceLabel }}</option>
        {% endfor %}
      </select>
      <div class="cloud-price">
        <strong data-cloud-price>{{ offer.durations[0].priceLabel }}</strong>
        <span data-cloud-period>{{ t.pricing.pricePeriod[offer.durations[0].months] }}</span>
      </div>
      <button class="btn btn-accent js-subscribe" type="button" data-offer-code="{{ offer.code }}" data-offer-name="{{ offer.name }}">{{ t.pricing.cloud.offersCta }}</button>
    </article>
    {% endfor %}
  </div>
  {% else %}
  <p class="price-empty">{{ t.pricing.cloud.empty }}</p>
  {% endif %}
</section>
{% endif %}

<dialog class="rdv-dialog subscribe-dialog" id="subscribe-dialog" data-api="{{ site.commercialApi }}" aria-labelledby="subscribe-title">
  <div class="rdv-head">
    <div>
      <span class="rdv-status"><i></i>ONIR CLOUD</span>
      <strong id="subscribe-title">{{ t.pricing.subscription.title }}</strong>
    </div>
    <button class="rdv-close" type="button" data-subscribe-close aria-label="{{ t.pricing.subscription.close }}">×</button>
  </div>
  <form class="rdv-form" data-subscribe-form>
    <p class="rdv-lead">{{ t.pricing.subscription.lead }}</p>
    <div class="subscribe-summary" data-subscribe-summary></div>
    <input name="offerCode" type="hidden">
    <label class="rdv-field">
      <span class="rdv-bubble">{{ t.pricing.subscription.duration }}</span>
      <select name="durationMonths" required></select>
    </label>
    <label class="rdv-field">
      <span class="rdv-bubble">{{ t.pricing.subscription.organization }}</span>
      <input name="organizationName" required autocomplete="organization">
    </label>
    <label class="rdv-field">
      <span class="rdv-bubble">{{ t.pricing.subscription.contactName }}</span>
      <input name="contactName" required autocomplete="name">
    </label>
    <label class="rdv-field">
      <span class="rdv-bubble">{{ t.pricing.subscription.email }}</span>
      <input name="contactEmail" type="email" required autocomplete="email">
    </label>
    <label class="rdv-field">
      <span class="rdv-bubble">{{ t.pricing.subscription.phone }}</span>
      <input name="contactPhone" type="tel" autocomplete="tel" placeholder="+261 ...">
    </label>
    <p class="rdv-error" data-subscribe-error hidden></p>
    <button class="btn btn-accent" type="submit">{{ t.pricing.subscription.submit }}</button>
  </form>
  <div class="subscribe-result" data-subscribe-result hidden>
    <h3>{{ t.pricing.subscription.successTitle }}</h3>
    <p>{{ t.pricing.subscription.successLead }}</p>
    <div class="subscribe-code" data-subscribe-code></div>
    <dl>
      <dt>{{ t.pricing.subscription.offerLabel }}</dt><dd data-subscribe-offer></dd>
      <dt>{{ t.pricing.subscription.amountLabel }}</dt><dd data-subscribe-amount></dd>
      <dt>{{ t.pricing.subscription.expiresLabel }}</dt><dd data-subscribe-expires></dd>
    </dl>
    <div class="subscribe-instructions">
      <strong>{{ t.pricing.subscription.instructionsLabel }}</strong>
      <p data-subscribe-instructions></p>
    </div>
    <button class="btn btn-ghost" type="button" data-subscribe-close>{{ t.pricing.subscription.close }}</button>
  </div>
</dialog>

<dialog class="rdv-dialog" id="rdv-chat" data-whatsapp="{{ site.whatsappUrl }}" aria-labelledby="rdv-title">
  <div class="rdv-head">
    <div>
      <span class="rdv-status"><i></i>ONIR</span>
      <strong id="rdv-title">{{ t.pricing.appointment.title }}</strong>
    </div>
    <button class="rdv-close" type="button" data-rdv-close aria-label="Fermer">×</button>
  </div>
  <form class="rdv-form" data-rdv-form>
    <p class="rdv-lead">{{ t.pricing.appointment.lead }}</p>
    <label class="rdv-field">
      <span class="rdv-bubble">{{ t.pricing.appointment.whatsapp }}</span>
      <input name="whatsapp" type="tel" autocomplete="tel" placeholder="+261 ...">
    </label>
    <label class="rdv-field">
      <span class="rdv-bubble">{{ t.pricing.appointment.email }}</span>
      <input name="email" type="email" autocomplete="email" placeholder="vous@exemple.com">
    </label>
    <label class="rdv-field">
      <span class="rdv-bubble">{{ t.pricing.appointment.need }}</span>
      <textarea name="need" rows="3"></textarea>
    </label>
    <label class="rdv-field">
      <span class="rdv-bubble">{{ t.pricing.appointment.budget }}</span>
      <input name="budget" type="text" placeholder="Ar / mois">
    </label>
    <label class="rdv-field">
      <span class="rdv-bubble">{{ t.pricing.appointment.timeline }}</span>
      <input name="timeline" type="text" placeholder="Ex. 1 à 3 mois">
    </label>
    <p class="rdv-error" data-rdv-error hidden></p>
    <button class="btn btn-accent" type="submit">{{ t.pricing.appointment.submit }}</button>
    <p class="rdv-note">{{ t.pricing.appointment.note }}</p>
  </form>
</dialog>
