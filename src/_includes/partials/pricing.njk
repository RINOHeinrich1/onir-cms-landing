<section class="section wrap" id="pricing">
  <div class="section-head">
    <p class="kicker">{{ t.pricing.kicker }}</p>
    <h2>{{ t.pricing.title }}</h2>
    <p>{{ t.pricing.lead }}</p>
  </div>
  <div class="pricing-grid">
    <article class="price-card">
      <span class="price-tag">{{ t.pricing.selfHosted.badge }}</span>
      <h3>{{ t.pricing.selfHosted.title }}</h3>
      <p class="price">{{ t.pricing.selfHosted.price }}</p>
      <p>{{ t.pricing.selfHosted.lead }}</p>
      <ul class="price-list">
        {% for item in t.pricing.selfHosted.items %}<li>{{ item }}</li>{% endfor %}
      </ul>
      <a class="btn btn-ghost" href="{{ site.github }}" target="_blank" rel="noreferrer">{{ t.pricing.selfHosted.cta }}</a>
    </article>

    <article class="price-card price-card-featured">
      <span class="price-tag">{{ t.pricing.cloud.badge }}</span>
      <h3>{{ t.pricing.cloud.title }}</h3>
      <p>{{ t.pricing.cloud.lead }}</p>
      {% if pricing.offers.length %}
      <div class="cloud-offers">
        {% for offer in pricing.offers %}
        <div class="cloud-offer">
          <div class="cloud-offer-head">
            <strong>{{ offer.name }}</strong>
            {% if offer.description %}<span>{{ offer.description }}</span>{% endif %}
          </div>
          <ul>
            {% for duration in offer.durations %}
            <li><span>{{ duration.months }} {{ t.pricing.months }}</span><b>{{ duration.priceLabel }}</b></li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}
      </div>
      {% else %}
      <p class="price-empty">{{ t.pricing.cloud.empty }}</p>
      {% endif %}
      <button class="btn btn-accent" type="button" data-rdv-open>{{ t.pricing.cloud.cta }}</button>
    </article>

    <article class="price-card">
      <span class="price-tag">{{ t.pricing.enterprise.badge }}</span>
      <h3>{{ t.pricing.enterprise.title }}</h3>
      <p>{{ t.pricing.enterprise.lead }}</p>
      <ul class="price-list">
        {% for item in t.pricing.enterprise.items %}<li>{{ item }}</li>{% endfor %}
      </ul>
      <button class="btn btn-accent" type="button" data-rdv-open>{{ t.pricing.enterprise.cta }}</button>
    </article>
  </div>
</section>

<dialog class="rdv-dialog" id="rdv-chat" data-whatsapp="{{ site.whatsappUrl }}" aria-labelledby="rdv-title">
  <div class="rdv-head">
    <div>
      <span class="rdv-status"><i></i>ONIR</span>
      <strong id="rdv-title">{{ t.pricing.appointment.title }}</strong>
    </div>
    <button class="rdv-close" type="button" data-rdv-close aria-label="Fermer">×</button>
  </div>
  <form class="rdv-form" data-rdv-form>
    <p class="rdv-lead">{{ t.pricing.appointment.lead }}</p>
    <label class="rdv-field">
      <span class="rdv-bubble">{{ t.pricing.appointment.whatsapp }}</span>
      <input name="whatsapp" type="tel" autocomplete="tel" placeholder="+261 ...">
    </label>
    <label class="rdv-field">
      <span class="rdv-bubble">{{ t.pricing.appointment.email }}</span>
      <input name="email" type="email" autocomplete="email" placeholder="vous@exemple.com">
    </label>
    <label class="rdv-field">
      <span class="rdv-bubble">{{ t.pricing.appointment.need }}</span>
      <textarea name="need" rows="3"></textarea>
    </label>
    <label class="rdv-field">
      <span class="rdv-bubble">{{ t.pricing.appointment.budget }}</span>
      <input name="budget" type="text" placeholder="Ar / mois">
    </label>
    <label class="rdv-field">
      <span class="rdv-bubble">{{ t.pricing.appointment.timeline }}</span>
      <input name="timeline" type="text" placeholder="Ex. 1 à 3 mois">
    </label>
    <p class="rdv-error" data-rdv-error hidden></p>
    <button class="btn btn-accent" type="submit">{{ t.pricing.appointment.submit }}</button>
    <p class="rdv-note">{{ t.pricing.appointment.note }}</p>
  </form>
</dialog>
