{% if headerVariant == "legacy" %}
<footer class="site-foot">
  <div class="site-wrap site-foot-inner">
    <div class="site-foot-brand">
      <a href="{{ locale.routes.home }}" class="brand brand-logo site-brand" aria-label="{{ t.common.brandHome }}">
        <img class="logo-light" src="{{ site.logoLight }}" alt="{{ site.name }}" width="600" height="177" loading="lazy" />
        <img class="logo-dark" src="{{ site.logoDark }}" alt="" aria-hidden="true" width="600" height="177" loading="lazy" />
      </a>
      <p>{{ p.footer.tagline or t.common.footer.legacyTagline }}</p>
    </div>
    <nav class="site-foot-nav" aria-label="{{ t.common.footer.aria }}">
      <a href="{{ locale.routes.features }}">{{ t.common.nav.features }}</a>
      <a href="{{ locale.routes.home }}#demos">{{ t.common.nav.demos }}</a>
      <a href="{{ locale.routes.themes }}">{{ t.common.nav.themes }}</a>
      <a href="{{ locale.routes.participate }}">{{ t.common.nav.participate }}</a>
      <a href="{{ site.documentation }}">{{ t.common.nav.documentation }}</a>
      <a href="{{ site.installationGuide }}">{{ t.common.nav.installation }}</a>
      <a href="{{ site.github }}" target="_blank" rel="noreferrer">{{ t.common.nav.github }}</a>
      <a href="{{ site.login }}">{{ t.common.nav.login }}</a>
      <a href="{{ locale.routes.legal }}">{{ t.common.nav.legal }}</a>
      <a href="{{ locale.routes.privacy }}">{{ t.common.nav.privacy }}</a>
    </nav>
    <div class="site-foot-contact">
      <span>{{ t.common.contact.kicker }}</span>
      <a class="site-foot-contact-icon" href="{{ site.whatsappUrl }}" target="_blank" rel="noopener" aria-label="WhatsApp : {{ site.whatsappNumber }}" title="WhatsApp : {{ site.whatsappNumber }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.52 3.48A11.9 11.9 0 0 0 12.06 0C5.5 0 .17 5.33.17 11.89c0 2.1.55 4.15 1.6 5.96L0 24l6.3-1.65a11.9 11.9 0 0 0 5.76 1.47h.01c6.56 0 11.89-5.33 11.89-11.89 0-3.18-1.24-6.17-3.44-8.45ZM12.07 21.8h-.01a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.28c0-5.45 4.43-9.88 9.9-9.88 2.64 0 5.12 1.03 6.98 2.9a9.82 9.82 0 0 1 2.9 6.99c0 5.45-4.43 9.88-9.88 9.88Zm5.42-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.06 2.87 1.21 3.07.15.2 2.09 3.2 5.07 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z" fill="currentColor"/></svg></a>
      <a class="site-foot-contact-icon" href="mailto:{{ site.contactEmail }}" aria-label="Email : {{ site.contactEmail }}" title="Email : {{ site.contactEmail }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="m3 7 9 6 9-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      <a class="site-foot-contact-icon" href="{{ site.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="1.8"/><path d="M7.5 10.5V17M7.5 7.5v.1M11.5 17v-3.7c0-1.5 1-2.5 2.4-2.5 1.3 0 2.1.9 2.1 2.5V17M11.5 10.5V17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></a>
      <a class="site-foot-contact-icon" href="{{ site.facebook }}" target="_blank" rel="noopener" aria-label="Facebook" title="Facebook"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14.5 8.5h2V5.5h-2.2C11.8 5.5 10 7.3 10 9.8v1.7H8v3h2V21h3v-6.5h2.4l.5-3h-2.9V9.8c0-.8.4-1.3 1.5-1.3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></a>
    </div>
    <p class="site-foot-meta">{{ t.common.footer.legacyMeta }}</p>
    {% if t.common.reviewNotice %}<p class="site-foot-review">{{ t.common.reviewNotice }}</p>{% endif %}
  </div>
</footer>
{% else %}
<footer class="site-foot">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="brand" href="{{ locale.routes.home }}" aria-label="{{ t.common.brandHome }}">
          <img class="light" src="{{ site.logoLight }}" alt="{{ site.name }}" width="600" height="177" />
          <img class="dark" src="{{ site.logoDark }}" alt="" width="600" height="177" />
        </a>
        <p>{{ p.footer.tagline or t.common.footer.tagline }}</p>
      </div>
      <nav class="foot-nav" aria-label="{{ t.common.footer.aria }}">
        <a href="{{ locale.routes.features }}">{{ t.common.nav.features }}</a>
        <a href="{{ locale.routes.home }}#demos">{{ t.common.nav.demos }}</a>
        <a href="{{ locale.routes.themes }}">{{ t.common.nav.themes }}</a>
        <a href="{{ locale.routes.participate }}">{{ t.common.nav.participate }}</a>
        <a href="{{ site.documentation }}">{{ t.common.nav.documentation }}</a>
        <a href="{{ site.github }}" target="_blank" rel="noreferrer">{{ t.common.nav.github }}</a>
        <a href="{{ site.login }}">{{ t.common.nav.login }}</a>
        <a href="{{ locale.routes.legal }}">{{ t.common.nav.legal }}</a>
        <a href="{{ locale.routes.privacy }}">{{ t.common.nav.privacy }}</a>
      </nav>
    </div>
    <div class="foot-contact">
      <span>{{ t.common.contact.kicker }}</span>
      <a class="foot-contact-icon" href="{{ site.whatsappUrl }}" target="_blank" rel="noopener" aria-label="WhatsApp : {{ site.whatsappNumber }}" title="WhatsApp : {{ site.whatsappNumber }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.52 3.48A11.9 11.9 0 0 0 12.06 0C5.5 0 .17 5.33.17 11.89c0 2.1.55 4.15 1.6 5.96L0 24l6.3-1.65a11.9 11.9 0 0 0 5.76 1.47h.01c6.56 0 11.89-5.33 11.89-11.89 0-3.18-1.24-6.17-3.44-8.45ZM12.07 21.8h-.01a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.28c0-5.45 4.43-9.88 9.9-9.88 2.64 0 5.12 1.03 6.98 2.9a9.82 9.82 0 0 1 2.9 6.99c0 5.45-4.43 9.88-9.88 9.88Zm5.42-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.06 2.87 1.21 3.07.15.2 2.09 3.2 5.07 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z" fill="currentColor"/></svg></a>
      <a class="foot-contact-icon" href="mailto:{{ site.contactEmail }}" aria-label="Email : {{ site.contactEmail }}" title="Email : {{ site.contactEmail }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="m3 7 9 6 9-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      <a class="foot-contact-icon" href="{{ site.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="1.8"/><path d="M7.5 10.5V17M7.5 7.5v.1M11.5 17v-3.7c0-1.5 1-2.5 2.4-2.5 1.3 0 2.1.9 2.1 2.5V17M11.5 10.5V17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></a>
      <a class="foot-contact-icon" href="{{ site.facebook }}" target="_blank" rel="noopener" aria-label="Facebook" title="Facebook"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14.5 8.5h2V5.5h-2.2C11.8 5.5 10 7.3 10 9.8v1.7H8v3h2V21h3v-6.5h2.4l.5-3h-2.9V9.8c0-.8.4-1.3 1.5-1.3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></a>
    </div>
    <div class="foot-meta">
      <span>{{ t.common.footer.metaOpenSource }}</span>
      <span>{{ p.footer.metaBrand or t.common.footer.metaBrand }}</span>
    </div>
    {% if t.common.reviewNotice %}<p class="foot-review">{{ t.common.reviewNotice }}</p>{% endif %}
  </div>
</footer>
{% endif %}
