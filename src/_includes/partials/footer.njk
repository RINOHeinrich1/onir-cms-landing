{% if headerVariant == "legacy" %}
<footer class="site-foot">
  <div class="site-wrap site-foot-inner">
    <div class="site-foot-brand">
      <a href="{{ locale.routes.home }}" class="brand brand-logo site-brand" aria-label="{{ t.common.brandHome }}">
        <img class="logo-light" src="{{ site.logoLight }}" alt="{{ site.name }}" width="600" height="177" loading="lazy" />
        <img class="logo-dark" src="{{ site.logoDark }}" alt="" aria-hidden="true" width="600" height="177" loading="lazy" />
      </a>
      <p>{{ p.footer.tagline or t.common.footer.legacyTagline }}</p>
    </div>
    <nav class="site-foot-nav" aria-label="{{ t.common.footer.aria }}">
      <a href="{{ locale.routes.features }}">{{ t.common.nav.features }}</a>
      <a href="{{ locale.routes.home }}#demos">{{ t.common.nav.demos }}</a>
      <a href="{{ locale.routes.themes }}">{{ t.common.nav.themes }}</a>
      <a href="{{ locale.routes.participate }}">{{ t.common.nav.participate }}</a>
      <a href="{{ site.documentation }}">{{ t.common.nav.documentation }}</a>
      <a href="{{ site.installationGuide }}">{{ t.common.nav.installation }}</a>
      <a href="{{ site.github }}" target="_blank" rel="noreferrer">{{ t.common.nav.github }}</a>
      <a href="{{ site.login }}">{{ t.common.nav.login }}</a>
      <a href="{{ locale.routes.legal }}">{{ t.common.nav.legal }}</a>
      <a href="{{ locale.routes.privacy }}">{{ t.common.nav.privacy }}</a>
    </nav>
    <div class="site-foot-contact">
      <span>{{ t.common.contact.kicker }}</span>
      <a class="site-foot-contact-icon" href="{{ site.whatsappUrl }}" target="_blank" rel="noopener" aria-label="WhatsApp : {{ site.whatsappNumber }}" title="WhatsApp : {{ site.whatsappNumber }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 3.7 19.1L2 22l3-.8A11.8 11.8 0 1 0 20.5 3.5Z" stroke="currentColor" stroke-width="1.8"/><path d="M8.2 7.4c.2-.5.4-.5.7-.5h.6c.2 0 .4 0 .6.5l.8 1.9c.1.3 0 .5-.1.7l-.6.8c-.2.2-.1.4 0 .6.5.9 1.2 1.6 2.1 2.1.2.1.4.2.6 0l.8-.6c.2-.2.4-.2.7-.1l1.9.8c.4.2.5.4.5.6v.6c0 .3 0 .5-.5.7-1.2.8-2.8.8-4.6-.1-1.8-.9-3.5-2.6-4.4-4.4-.9-1.8-1-3.4-.2-4.6Z" fill="currentColor"/></svg></a>
      <a class="site-foot-contact-icon" href="mailto:{{ site.contactEmail }}" aria-label="Email : {{ site.contactEmail }}" title="Email : {{ site.contactEmail }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="m3 7 9 6 9-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
    </div>
    <p class="site-foot-meta">{{ t.common.footer.legacyMeta }}</p>
    {% if t.common.reviewNotice %}<p class="site-foot-review">{{ t.common.reviewNotice }}</p>{% endif %}
  </div>
</footer>
{% else %}
<footer class="site-foot">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="brand" href="{{ locale.routes.home }}" aria-label="{{ t.common.brandHome }}">
          <img class="light" src="{{ site.logoLight }}" alt="{{ site.name }}" width="600" height="177" />
          <img class="dark" src="{{ site.logoDark }}" alt="" width="600" height="177" />
        </a>
        <p>{{ p.footer.tagline or t.common.footer.tagline }}</p>
      </div>
      <nav class="foot-nav" aria-label="{{ t.common.footer.aria }}">
        <a href="{{ locale.routes.features }}">{{ t.common.nav.features }}</a>
        <a href="{{ locale.routes.home }}#demos">{{ t.common.nav.demos }}</a>
        <a href="{{ locale.routes.themes }}">{{ t.common.nav.themes }}</a>
        <a href="{{ locale.routes.participate }}">{{ t.common.nav.participate }}</a>
        <a href="{{ site.documentation }}">{{ t.common.nav.documentation }}</a>
        <a href="{{ site.github }}" target="_blank" rel="noreferrer">{{ t.common.nav.github }}</a>
        <a href="{{ site.login }}">{{ t.common.nav.login }}</a>
        <a href="{{ locale.routes.legal }}">{{ t.common.nav.legal }}</a>
        <a href="{{ locale.routes.privacy }}">{{ t.common.nav.privacy }}</a>
      </nav>
    </div>
    <div class="foot-contact">
      <span>{{ t.common.contact.kicker }}</span>
      <a class="foot-contact-icon" href="{{ site.whatsappUrl }}" target="_blank" rel="noopener" aria-label="WhatsApp : {{ site.whatsappNumber }}" title="WhatsApp : {{ site.whatsappNumber }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 3.7 19.1L2 22l3-.8A11.8 11.8 0 1 0 20.5 3.5Z" stroke="currentColor" stroke-width="1.8"/><path d="M8.2 7.4c.2-.5.4-.5.7-.5h.6c.2 0 .4 0 .6.5l.8 1.9c.1.3 0 .5-.1.7l-.6.8c-.2.2-.1.4 0 .6.5.9 1.2 1.6 2.1 2.1.2.1.4.2.6 0l.8-.6c.2-.2.4-.2.7-.1l1.9.8c.4.2.5.4.5.6v.6c0 .3 0 .5-.5.7-1.2.8-2.8.8-4.6-.1-1.8-.9-3.5-2.6-4.4-4.4-.9-1.8-1-3.4-.2-4.6Z" fill="currentColor"/></svg></a>
      <a class="foot-contact-icon" href="mailto:{{ site.contactEmail }}" aria-label="Email : {{ site.contactEmail }}" title="Email : {{ site.contactEmail }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="m3 7 9 6 9-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
    </div>
    <div class="foot-meta">
      <span>{{ t.common.footer.metaOpenSource }}</span>
      <span>{{ p.footer.metaBrand or t.common.footer.metaBrand }}</span>
    </div>
    {% if t.common.reviewNotice %}<p class="foot-review">{{ t.common.reviewNotice }}</p>{% endif %}
  </div>
</footer>
{% endif %}
