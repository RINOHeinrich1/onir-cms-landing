---
layout: layouts/base.njk
pageKey: home
headerVariant: v2
css:
  - /assets/css/landing-v2.css?v=12
  - /assets/css/pricing.css?v=2
  - /assets/css/hero-video.css?v=4
bodyScripts:
  - /assets/js/appointment-chat.js?v=1
  - /assets/js/subscription.js?v=1
  - /assets/js/pricing-duration.js?v=1
  - /assets/js/demo-carousel.js?v=1
  - /assets/js/hero-video.js?v=2
showWidget: true
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.routes.home }}index.html"
---
<section class="hero wrap">
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="kicker">{{ p.hero.kicker }}</p>
      <h1>{{ p.hero.title }} <em>{{ p.hero.titleEmphasis }}</em></h1>
      <p class="hero-lead">{{ p.hero.lead }}</p>
      <div class="hero-ctas">
        <a class="btn btn-accent btn-xl" href="#demos">{{ p.hero.cta }}</a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="mock" aria-hidden="true">
        <div class="mock-inner">
          <div class="mock-bar">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            <span class="mock-url">{{ p.mock.url }}</span>
          </div>
          <div class="mock-body">
            <div class="mock-rail">
              {% for item in p.mock.rail %}<span{% if loop.first %} class="on"{% endif %}>{{ item }}</span>{% endfor %}
            </div>
            <div class="mock-main">
              <div class="mock-title">
                <strong>{{ p.mock.title }}</strong>
                <span class="pill">{{ p.mock.status }}</span>
              </div>
              <div class="mock-steps">
                {% for step in p.mock.steps %}
                <div class="mock-step{% if loop.index <= 2 %} done{% endif %}"><i>{{ loop.index }}</i> {{ step.label }} <span>{{ step.value }}</span></div>
                {% endfor %}
              </div>
              <div class="mock-channels">
                {% for channel in p.mock.channels %}<b>{{ channel }}</b>{% endfor %}
              </div>
              <div class="mock-live">{{ p.mock.live }}</div>
            </div>
          </div>
        </div>
      </div>
      <button class="hero-play" type="button" data-hero-video-open aria-label="Play the A2DM Formation contact demo">
        <span class="hero-play-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z"/></svg>
        </span>
      </button>
    </div>
  </div>
</section>

<dialog class="hero-video-modal" data-hero-video-modal aria-label="A2DM Formation contact demo">
  <div class="hero-video-shell">
    <button class="hero-video-close" type="button" data-hero-video-close aria-label="Close video">×</button>
    <video
      class="hero-video-player"
      data-hero-video
      data-desktop-src-en="/assets/videos/onir-motion-en-desktop.mp4?v=5"
      data-mobile-src-en="/assets/videos/onir-motion-en-mobile.mp4?v=5"
      data-desktop-poster-en="/assets/videos/onir-motion-en-desktop-poster.jpg?v=5"
      data-mobile-poster-en="/assets/videos/onir-motion-en-mobile-poster.jpg?v=5"
      data-desktop-src-fr="/assets/videos/onir-motion-fr-desktop.mp4?v=5"
      data-mobile-src-fr="/assets/videos/onir-motion-fr-mobile.mp4?v=5"
      data-desktop-poster-fr="/assets/videos/onir-motion-fr-desktop-poster.jpg?v=5"
      data-mobile-poster-fr="/assets/videos/onir-motion-fr-mobile-poster.jpg?v=5"
      data-desktop-src-mg="/assets/videos/onir-motion-mg-desktop.mp4?v=5"
      data-mobile-src-mg="/assets/videos/onir-motion-mg-mobile.mp4?v=5"
      data-desktop-poster-mg="/assets/videos/onir-motion-mg-desktop-poster.jpg?v=5"
      data-mobile-poster-mg="/assets/videos/onir-motion-mg-mobile-poster.jpg?v=5"
      controls
      playsinline
      preload="metadata"
    ></video>
  </div>
</dialog>

<section class="section wrap" id="demos">
  <div class="section-head">
    <p class="kicker">{{ p.demos.kicker }}</p>
    <h2>{{ p.demos.title }}</h2>
    <p>{{ p.demos.lead }}</p>
  </div>
  <div class="demo-carousel" data-demo-carousel>
    <button class="demo-arrow demo-arrow--prev" type="button" data-demo-prev aria-label="{{ p.demos.previous }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7"/></svg>
    </button>
    <button class="demo-arrow demo-arrow--next" type="button" data-demo-next aria-label="{{ p.demos.next }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
    </button>
    <div class="demo-track" data-demo-track>
      {% for item in p.demos.items %}
      <div class="demo-slide">
        <a class="demo-card" href="{{ demoLinks[item.key] }}" target="_blank" rel="noreferrer">
          <span class="demo-card-preview">
            <img src="{{ item.image }}" alt="" loading="lazy">
          </span>
          <span class="demo-card-body">
            <span class="demo-tag">{{ item.tag }}</span>
            <h3>{{ item.title }}</h3>
            <span class="demo-card-creator">{{ item.creator }}</span>
            <p>{{ item.lead }}</p>
            <span class="demo-cta">{{ p.demos.cta }}</span>
          </span>
        </a>
      </div>
      {% endfor %}
    </div>
    <div class="demo-dots" data-demo-dots aria-label="{{ p.demos.title }}"></div>
  </div>
</section>

<section class="wrap">
  <div class="band band-solo">
    <div class="inner">
      <p class="kicker">{{ p.openSource.kicker }}</p>
      <h2>{{ p.openSource.title }}</h2>
      <p>{{ p.openSource.lead }}</p>
      <a class="btn btn-light" href="{{ site.github }}" target="_blank" rel="noreferrer">{{ p.openSource.cta }}</a>
    </div>
  </div>
</section>

<section class="section wrap">
  <div class="split">
    <div class="split-copy">
      <p class="kicker">{{ p.malagasy.kicker }}</p>
      <h2>{{ p.malagasy.title }}</h2>
      <p>{{ p.malagasy.lead }}</p>
    </div>
    <div class="split-visual flag-card">
      {% set mapLabel = p.malagasy.mapLabel %}
      {% include "components/malagasy-map.njk" %}
      <p class="flag-caption">{{ p.malagasy.caption }}</p>
    </div>
  </div>
</section>

<section class="section wrap">
  <div class="section-head">
    <p class="kicker">{{ p.providers.kicker }}</p>
    <h2>{{ p.providers.title }}</h2>
    <p>{{ p.providers.lead }}</p>
  </div>
  {% include "components/providers.njk" %}
  <p class="providers-note">{{ p.providers.note }}</p>
</section>

<section class="section wrap">
  <div class="section-head">
    <p class="kicker">{{ p.features.kicker }}</p>
    <h2>{{ p.features.title }}</h2>
  </div>
  <div class="simple-grid">
    {% for item in p.features.items %}
    <article class="simple">
      <h3>{{ item.title }}</h3>
      <p>{{ item.lead }}</p>
    </article>
    {% endfor %}
  </div>
  <div class="hero-ctas">
    <a class="btn btn-ghost" href="{{ locale.routes.features }}">{{ p.features.cta }}</a>
  </div>
</section>

{% include "partials/pricing.njk" %}


