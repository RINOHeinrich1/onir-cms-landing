---
layout: layouts/base.njk
pageKey: home
headerVariant: v2
css:
  - /assets/css/landing-v2.css?v=11
  - /assets/css/pricing.css?v=1
bodyScripts:
  - /assets/js/appointment-chat.js?v=1
showWidget: true
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.routes.home }}index.html"
---
<section class="hero wrap">
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="kicker">{{ p.hero.kicker }}</p>
      <h1>{{ p.hero.title }} <em>{{ p.hero.titleEmphasis }}</em></h1>
      <p class="hero-lead">{{ p.hero.lead }}</p>
      <div class="hero-ctas">
        <a class="btn btn-accent btn-xl" href="#demos">{{ p.hero.cta }}</a>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="mock">
        <div class="mock-inner">
          <div class="mock-bar">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            <span class="mock-url">{{ p.mock.url }}</span>
          </div>
          <div class="mock-body">
            <div class="mock-rail">
              {% for item in p.mock.rail %}<span{% if loop.first %} class="on"{% endif %}>{{ item }}</span>{% endfor %}
            </div>
            <div class="mock-main">
              <div class="mock-title">
                <strong>{{ p.mock.title }}</strong>
                <span class="pill">{{ p.mock.status }}</span>
              </div>
              <div class="mock-steps">
                {% for step in p.mock.steps %}
                <div class="mock-step{% if loop.index <= 2 %} done{% endif %}"><i>{{ loop.index }}</i> {{ step.label }} <span>{{ step.value }}</span></div>
                {% endfor %}
              </div>
              <div class="mock-channels">
                {% for channel in p.mock.channels %}<b>{{ channel }}</b>{% endfor %}
              </div>
              <div class="mock-live">{{ p.mock.live }}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section wrap" id="demos">
  <div class="section-head">
    <p class="kicker">{{ p.demos.kicker }}</p>
    <h2>{{ p.demos.title }}</h2>
    <p>{{ p.demos.lead }}</p>
  </div>
  <div class="demo-cards">
    {% for item in p.demos.items %}
    <a class="demo-card" href="{{ demoLinks[item.key] }}" target="_blank" rel="noreferrer">
      <span class="demo-tag">{{ item.tag }}</span>
      <h3>{{ item.title }}</h3>
      <p>{{ item.lead }}</p>
      <span class="demo-cta">{{ p.demos.cta }}</span>
    </a>
    {% endfor %}
  </div>
</section>

<section class="wrap">
  <div class="band band-solo">
    <div class="inner">
      <p class="kicker">{{ p.openSource.kicker }}</p>
      <h2>{{ p.openSource.title }}</h2>
      <p>{{ p.openSource.lead }}</p>
      <a class="btn btn-light" href="{{ site.github }}" target="_blank" rel="noreferrer">{{ p.openSource.cta }}</a>
    </div>
  </div>
</section>

<section class="section wrap">
  <div class="split">
    <div class="split-copy">
      <p class="kicker">{{ p.malagasy.kicker }}</p>
      <h2>{{ p.malagasy.title }}</h2>
      <p>{{ p.malagasy.lead }}</p>
    </div>
    <div class="split-visual flag-card">
      {% set mapLabel = p.malagasy.mapLabel %}
      {% include "components/malagasy-map.njk" %}
      <p class="flag-caption">{{ p.malagasy.caption }}</p>
    </div>
  </div>
</section>

<section class="section wrap">
  <div class="section-head">
    <p class="kicker">{{ p.providers.kicker }}</p>
    <h2>{{ p.providers.title }}</h2>
    <p>{{ p.providers.lead }}</p>
  </div>
  {% include "components/providers.njk" %}
  <p class="providers-note">{{ p.providers.note }}</p>
</section>

<section class="section wrap">
  <div class="section-head">
    <p class="kicker">{{ p.features.kicker }}</p>
    <h2>{{ p.features.title }}</h2>
  </div>
  <div class="simple-grid">
    {% for item in p.features.items %}
    <article class="simple">
      <h3>{{ item.title }}</h3>
      <p>{{ item.lead }}</p>
    </article>
    {% endfor %}
  </div>
  <div class="hero-ctas">
    <a class="btn btn-ghost" href="{{ locale.routes.features }}">{{ p.features.cta }}</a>
  </div>
</section>

<section class="section wrap" id="pricing">
  <div class="section-head">
    <p class="kicker">{{ p.pricing.kicker }}</p>
    <h2>{{ p.pricing.title }}</h2>
    <p>{{ p.pricing.lead }}</p>
  </div>
  <div class="pricing-grid">
    <article class="price-card">
      <span class="price-tag">{{ p.pricing.selfHosted.badge }}</span>
      <h3>{{ p.pricing.selfHosted.title }}</h3>
      <p class="price">{{ p.pricing.selfHosted.price }}</p>
      <p>{{ p.pricing.selfHosted.lead }}</p>
      <ul class="price-list">
        {% for item in p.pricing.selfHosted.items %}<li>{{ item }}</li>{% endfor %}
      </ul>
      <a class="btn btn-ghost" href="{{ site.github }}" target="_blank" rel="noreferrer">{{ p.pricing.selfHosted.cta }}</a>
    </article>

    <article class="price-card price-card-featured">
      <span class="price-tag">{{ p.pricing.cloud.badge }}</span>
      <h3>{{ p.pricing.cloud.title }}</h3>
      <p>{{ p.pricing.cloud.lead }}</p>
      {% if pricing.offers.length %}
      <div class="cloud-offers">
        {% for offer in pricing.offers %}
        <div class="cloud-offer">
          <div class="cloud-offer-head">
            <strong>{{ offer.name }}</strong>
            {% if offer.description %}<span>{{ offer.description }}</span>{% endif %}
          </div>
          <ul>
            {% for duration in offer.durations %}
            <li><span>{{ duration.months }} {{ p.pricing.months }}</span><b>{{ duration.priceLabel }}</b></li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}
      </div>
      {% else %}
      <p class="price-empty">{{ p.pricing.cloud.empty }}</p>
      {% endif %}
      <button class="btn btn-accent" type="button" data-rdv-open>{{ p.pricing.cloud.cta }}</button>
    </article>

    <article class="price-card">
      <span class="price-tag">{{ p.pricing.enterprise.badge }}</span>
      <h3>{{ p.pricing.enterprise.title }}</h3>
      <p>{{ p.pricing.enterprise.lead }}</p>
      <ul class="price-list">
        {% for item in p.pricing.enterprise.items %}<li>{{ item }}</li>{% endfor %}
      </ul>
      <button class="btn btn-accent" type="button" data-rdv-open>{{ p.pricing.enterprise.cta }}</button>
    </article>
  </div>
</section>

<dialog class="rdv-dialog" id="rdv-chat" data-whatsapp="{{ site.whatsappUrl }}" aria-labelledby="rdv-title">
  <div class="rdv-head">
    <div>
      <span class="rdv-status"><i></i>ONIR</span>
      <strong id="rdv-title">{{ p.pricing.appointment.title }}</strong>
    </div>
    <button class="rdv-close" type="button" data-rdv-close aria-label="Fermer">×</button>
  </div>
  <form class="rdv-form" data-rdv-form>
    <p class="rdv-lead">{{ p.pricing.appointment.lead }}</p>
    <label class="rdv-field">
      <span class="rdv-bubble">{{ p.pricing.appointment.whatsapp }}</span>
      <input name="whatsapp" type="tel" autocomplete="tel" placeholder="+261 ...">
    </label>
    <label class="rdv-field">
      <span class="rdv-bubble">{{ p.pricing.appointment.email }}</span>
      <input name="email" type="email" autocomplete="email" placeholder="vous@exemple.com">
    </label>
    <label class="rdv-field">
      <span class="rdv-bubble">{{ p.pricing.appointment.need }}</span>
      <textarea name="need" rows="3"></textarea>
    </label>
    <label class="rdv-field">
      <span class="rdv-bubble">{{ p.pricing.appointment.budget }}</span>
      <input name="budget" type="text" placeholder="Ar / mois">
    </label>
    <label class="rdv-field">
      <span class="rdv-bubble">{{ p.pricing.appointment.timeline }}</span>
      <input name="timeline" type="text" placeholder="Ex. 1 à 3 mois">
    </label>
    <p class="rdv-error" data-rdv-error hidden></p>
    <button class="btn btn-accent" type="submit">{{ p.pricing.appointment.submit }}</button>
    <p class="rdv-note">{{ p.pricing.appointment.note }}</p>
  </form>
</dialog>

<section class="section wrap">
  <div class="support">
    <div>
      <p class="kicker">{{ p.support.kicker }}</p>
      <h2>{{ p.support.title }}</h2>
      <p>{{ p.support.lead }}</p>
    </div>
    <a class="btn btn-accent" href="{{ locale.routes.participate }}">{{ p.support.cta }}</a>
  </div>
</section>
