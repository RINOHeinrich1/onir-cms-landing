---
layout: layouts/base.njk
pageKey: pricing
headerVariant: v2
css:
  - /assets/css/landing-v2.css?v=11
  - /assets/css/pricing.css?v=2
bodyScripts:
  - /assets/js/appointment-chat.js?v=1
  - /assets/js/subscription.js?v=1
  - /assets/js/pricing-duration.js?v=1
  - /assets/js/pricing-carousel.js?v=1
  - /assets/js/pricing-top-carousel.js?v=1
  - /assets/js/market-switch.js?v=1
showWidget: true
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.routes.pricing }}index.html"
---
<section class="page-hero wrap">
  <p class="kicker">{{ t.pricing.support.kicker }}</p>
  <h1>{{ t.pricing.support.title }}</h1>
  <p class="hero-lead">{{ t.pricing.support.lead }}</p>
</section>

<div class="wrap market-switch" data-market-switch>
  <span class="market-switch-label">{{ t.pricing.market.label }}</span>
  <button class="market-button is-active" data-market="MG" type="button">{{ t.pricing.market.madagascar }}</button>
  <button class="market-button" data-market="INTL" type="button">{{ t.pricing.market.international }}</button>
</div>

<div class="wrap market-notice" data-madagascar-only>
  <strong>{{ t.pricing.market.cloudTitle }}</strong>
  <p>{{ t.pricing.market.cloudLead }} <a href="?market=international">{{ t.pricing.market.internationalLink }}</a></p>
</div>

<div class="wrap market-notice" data-international-only>
  <strong>{{ t.pricing.market.cloudTitle }}</strong>
  <p>{{ t.pricing.market.cloudLead }}</p>
</div>

{% include "partials/pricing.njk" %}

<section class="cta wrap">
  <p class="kicker">{{ t.pricing.ctaKicker }}</p>
  <h2>{{ t.pricing.ctaTitle }}</h2>
  <p>{{ t.pricing.ctaLead }}</p>
  <div class="cta-row">
    <button class="btn btn-accent" type="button" data-rdv-open>{{ t.pricing.ctaButton }}</button>
    <a class="btn btn-ghost" href="{{ site.github }}" target="_blank" rel="noreferrer">{{ t.pricing.selfHosted.cta }}</a>
  </div>
</section>
