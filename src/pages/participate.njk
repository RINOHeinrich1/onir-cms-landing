---
layout: layouts/base.njk
pageKey: participate
headerVariant: legacy
wrapper: site
mainClass: site-main
showWidget: true
partnerChat: true
viewport: "width=device-width, initial-scale=1, interactive-widget=resizes-content"
css:
  - /assets/css/base.css
  - /assets/css/landing.css?v=20261104b
  - /assets/css/participer.css?v=20261110a
headExtra: |
  <script type="importmap">
    {
      "imports": {
        "three": "/assets/vendor/three/three.module.min.js",
        "three/addons/": "/assets/vendor/three-addons/"
      }
    }
  </script>
bodyScripts:
  - /assets/data/town-layout.js?v=20261110a
  - /assets/data/sponsors.js?v=20261026i
  - /assets/js/participer.js?v=20261110a
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.routes.participate }}index.html"
---
<div class="site-wrap participate-page">
  <div class="participate-tabs" role="tablist" aria-label="{{ p.tabs.aria }}">
    <button type="button" id="tab-sponsor" role="tab" aria-selected="true" aria-controls="panel-sponsor" data-tab="sponsor">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 21V8l8-5 8 5v13" /><path d="M9 21v-6h6v6" />
      </svg>
      <span>{{ p.tabs.sponsor }}</span>
    </button>
    <button type="button" id="tab-developpeur" role="tab" aria-selected="false" aria-controls="panel-developpeur" tabindex="-1" data-tab="developpeur">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m8 9-4 3 4 3M16 9l4 3-4 3M14 5l-4 14" />
      </svg>
      <span>{{ p.tabs.developer }}</span>
    </button>
  </div>

  <section id="panel-sponsor" role="tabpanel" aria-labelledby="tab-sponsor" data-panel="sponsor">
    <div class="sponsor-intro">
      <h1>{{ p.sponsor.title }}</h1>
      <a class="site-button site-button-light" href="{{ site.partnerChat }}" target="_blank" rel="noopener">{{ p.sponsor.cta }}</a>
    </div>

    <div class="town-stage" data-town-stage data-town-api-url="{{ site.partnerApi }}">
      <div class="town-toolbar">
        <span class="town-summary" data-town-summary aria-live="polite"></span>
        <div class="town-tools">
          <button type="button" class="town-tool" data-view-toggle aria-pressed="false" aria-controls="town-map">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z" /><path d="m4 7.5 8 4.5 8-4.5M12 12v9" />
            </svg>
            <span data-view-label>{{ p.sponsor.viewToggle }}</span>
          </button>
        </div>
      </div>

      <div class="town-viewport">
        <div class="map-perspective">
          <svg id="town-map" class="town-map" data-town-map viewBox="0 0 1200 760" role="group" aria-label="{{ p.sponsor.mapLabel }}"></svg>
          <div class="town-3d" data-town-3d hidden>
            <span class="town-3d-loading">{{ p.sponsor.loading }}</span>
          </div>
        </div>
        <div class="map-hover" data-map-hover aria-hidden="true"></div>
      </div>

      <p class="town-status" data-town-status hidden></p>
      <div class="map-legend" aria-label="{{ p.sponsor.legendAria }}">
        {% for item in p.sponsor.legend %}
        <span><i class="legend-dot{% if loop.index == 2 %} legend-dot-house{% elif loop.index == 3 %} legend-dot-empty{% endif %}" aria-hidden="true"></i>{{ item }}</span>
        {% endfor %}
      </div>
    </div>
    {% if p.sponsor.runtimeNotice %}<p class="runtime-notice">{{ p.sponsor.runtimeNotice }}</p>{% endif %}
    <p class="sr-only" data-view-status aria-live="polite"></p>
  </section>

  <section id="panel-developpeur" class="dev-tab" role="tabpanel" aria-labelledby="tab-developpeur" data-panel="developpeur" hidden>
    <div class="dev-intro">
      <p class="site-kicker"><span class="site-kicker-dot"></span>{{ p.developer.kicker }}</p>
      <h1>{{ p.developer.title }}</h1>
      <p class="site-lead">{{ p.developer.lead }}</p>
      <div class="participate-actions">
        <a href="{{ site.github }}" class="site-button" target="_blank" rel="noreferrer">{{ p.developer.github }}</a>
        <a href="{{ site.documentation }}" class="site-button site-button-ghost">{{ p.developer.docs }}</a>
      </div>
      <p class="participate-note">{{ p.developer.note }}</p>
    </div>

    <div class="dev-grid">
      {% for card in p.developer.cards %}
      <article class="dev-card">
        <span class="dev-number">{{ card.number }}</span>
        <h2>{{ card.title }}</h2>
        <p>{{ card.text }}</p>
        {% if loop.index == 1 %}
        <a href="{{ site.github }}/issues" class="site-button site-button-sm" target="_blank" rel="noreferrer">{{ card.cta }}</a>
        {% elif loop.index == 2 %}
        <a href="{{ site.templatesGuide }}" class="site-button site-button-sm" target="_blank" rel="noreferrer">{{ card.cta }}</a>
        {% else %}
        <a href="{{ site.github }}/issues/new" class="site-button site-button-sm" target="_blank" rel="noreferrer">{{ card.cta }}</a>
        {% endif %}
      </article>
      {% endfor %}
    </div>
  </section>
</div>

<dialog class="sponsor-chat" data-sponsor-chat aria-labelledby="sponsor-chat-title">
  <div class="chat-panel">
    <header class="chat-head">
      <span class="chat-head-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 21V8l8-5 8 5v13" /><path d="M9 21v-6h6v6" />
        </svg>
      </span>
      <div class="chat-head-copy">
        <strong id="sponsor-chat-title">{{ p.chat.title }}</strong>
        <span>{{ p.chat.subtitle }}</span>
      </div>
      <button type="button" class="chat-close" data-chat-close aria-label="{{ p.chat.close }}">×</button>
    </header>
    <div class="chat-progress">
      <div class="chat-progress-track"><div class="chat-progress-bar" data-chat-progress-bar></div></div>
      <div class="chat-progress-copy"><span data-chat-progress-label>{{ p.chat.progress }}</span><span>{{ p.chat.demo }}</span></div>
    </div>
    <div class="chat-log" data-chat-log aria-live="polite"></div>
    <div class="chat-controls" data-chat-controls></div>
  </div>
</dialog>

<dialog class="sponsor-sheet" data-sponsor-sheet aria-labelledby="sponsor-sheet-title">
  <div class="sponsor-sheet-body" data-sponsor-sheet-body></div>
</dialog>
