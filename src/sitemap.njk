---
permalink: sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for item in sitemapPages %}
{%- for locale in allLocales %}
{%- if locale.available %}
  <url>
    <loc>{{ site.baseUrl }}{{ locale.routes[item.pageKey] }}</loc>
    <changefreq>{{ item.changefreq }}</changefreq>
    <priority>{{ item.priority }}</priority>
    {%- for alt in allLocales %}
    {%- if alt.available %}
    <xhtml:link rel="alternate" hreflang="{{ alt.htmlLang }}" href="{{ site.baseUrl }}{{ alt.routes[item.pageKey] }}" />
    {%- endif %}
    {%- endfor %}
  </url>
{%- endif %}
{%- endfor %}
{%- endfor %}
  <url>
    <loc>{{ site.baseUrl }}/articles/</loc>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
{%- for article in collections.articles %}
  <url>
    <loc>{{ site.baseUrl }}{{ article.url }}</loc>
    {%- if article.data.publishedAt %}
    <lastmod>{{ article.data.publishedAt }}</lastmod>
    {%- endif %}
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
{%- endfor %}
{%- for useCasePage in useCasePages %}
  <url>
    <loc>{{ site.baseUrl }}{{ useCasePage.route }}</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
    {%- for alt in useCasePage.alternates %}
    <xhtml:link rel="alternate" hreflang="{{ alt.hreflang }}" href="{{ site.baseUrl }}{{ alt.href }}" />
    {%- endfor %}
  </url>
{%- endfor %}
{%- for themePage in themePages %}
  <url>
    <loc>{{ site.baseUrl }}{{ themePage.route }}</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
    {%- for alt in themePage.alternates %}
    <xhtml:link rel="alternate" hreflang="{{ alt.hreflang }}" href="{{ site.baseUrl }}{{ alt.href }}" />
    {%- endfor %}
  </url>
{%- endfor %}
</urlset>
